# AccessBell configuration.
# Copy to .env (or export) before running `uvicorn backend.main:app`.

# ---- Core ----
MOCK_MODE=true
LLM_PROVIDER=stub            # stub | bedrock | openai | anthropic | google | ollama
DB_URL=                      # sqlite:///accessbell.db (default) | postgresql://user:pw@host:5432/db
DB_PATH=accessbell.db        # used when DB_URL is empty
PORT=8080
WEB_DIR=web
MOCK_EVENTS_DIR=mock/events
LOG_LEVEL=INFO

# ---- LLM trial (LangChain) ----
# stub is the offline default and needs nothing. For live providers set LLM_PROVIDER
# and the matching key; LLM_MODEL is optional (sensible defaults are used per provider).
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
LLM_TIMEOUT_SECONDS=5

# ---- Ring (live integration) ----
# Partner API docs: https://developer.amazon.com/docs/ring/api-documentation.html
# Webhook signature header is X-Signature: sha256=<hmac-hex> (Partner API).
RING_WEBHOOK_ENABLED=false
RING_WEBHOOK_SECRET=
RING_SIGNATURE_HEADER=X-Signature
RING_API_BASE_URL=https://api.amazonvision.com
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_ACCOUNT_TOKEN=

# ---- MCP / Alexa+ ----
MCP_HTTP_TOKEN=change-me
MCP_ORIGIN=
# OAuth 2.1 for /mcp (RFC 8707 resource server). Leave OAUTH_ISSUER empty to fall
# back to MCP_HTTP_TOKEN for offline/demo mode — no account needed.
#
# Cognito is ONE option; the verifier is IdP-agnostic (JWKS discovery + scopes).
# No AWS account? Any OAuth 2.1 issuer works:
#   Okta (free dev org):
#     OAUTH_ISSUER=https://<org>.okta.com/oauth2/default
#     OAUTH_JWKS_URL=https://<org>.okta.com/oauth2/default/v1/keys
#     + create app with client_credentials + authorization_code (PKCE), scopes mcp:service/mcp:tools/mcp:resources
#   Auth0 (free tier):
#     OAUTH_ISSUER=https://<tenant>.<region>.auth0.com/
#   Keycloak (self-hosted, docker run -p 8081:8080 quay.io/keycloak/keycloak):
#     OAUTH_ISSUER=http://localhost:8081/realms/master
#   Cognito (if/when you get an AWS account):
#     OAUTH_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_AUDIENCE=
MCP_RESOURCE=
OAUTH_REQUIRE_RESOURCE=false
# Alexa+ MCP checklist: 401 must NOT include WWW-Authenticate (not supported yet).
# Set false when targeting Alexa+; keep true for RFC 9728 discovery demos.
MCP_401_WWW_AUTHENTICATE=true
# Cloudflare Access: accept Cf-Access-Jwt-Assertion as a user-tier token (Access handles
# the policy). Set OAUTH_ISSUER=https://<team>.cloudflareaccess.com,
# OAUTH_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs,
# OAUTH_AUDIENCE=<Access application AUD tag>.
CF_ACCESS_JWT_ENABLED=false

# ---- Calendar MCP join (J2, optional, default OFF) ----
# When set, Tier 2 calls the Calendar MCP list_events tool and cites "calendar:" evidence.
# Leave empty to keep AccessBell standalone (docker compose up runs the local stub).
CALENDAR_MCP_URL=
CALENDAR_MCP_TOKEN=

# ---- Latency budgets (SLO) ----
# Richer context never delays Tier 1. Slower calendar calls fail open with context_status=timeout.
CONTEXT_BUDGET_MS=200
ENRICH_BUDGET_MS=2000

# ---- Quiet hours (UX only, never evidence) ----
# Calm phrasing for night motion, e.g. 22:00 / 07:00. Leave empty to disable.
QUIET_HOURS_START=
QUIET_HOURS_END=

# ---- API auth (REST + SSE) ----
# Local LAN demo: leave disabled. Public deploy: set API_AUTH_DISABLED=false and a strong API_TOKEN;
# clients send Authorization: Bearer <token>, ?token=<token>, or the accessbell_token cookie.
API_AUTH_DISABLED=true
API_TOKEN=

# ---- Scheduled retention purge ----
PURGE_INTERVAL_S=86400

# ---- Security & ops ----
DEMO_TOKEN=
RATE_LIMIT_PER_MINUTE=30
DEBOUNCE_SECONDS=10
EVENT_TTL_DAYS=30
ANNOUNCE_ENABLED=false